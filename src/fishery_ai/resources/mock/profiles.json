{
  "profiles": [
    {
      "profile_id": "cloud-demo",
      "display_name": "Cloud OpenAI-compatible example",
      "provider_kind": "openai-compatible-cloud",
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-v4-flash",
      "secret_env": "DEEPSEEK_API_KEY",
      "connect_timeout_s": 5,
      "read_timeout_s": 30,
      "total_timeout_s": 120,
      "max_retries": 1,
      "capabilities": {"streaming": true, "tool_calling": false}
    },
    {
      "profile_id": "local-demo",
      "display_name": "Local OpenAI-compatible example",
      "provider_kind": "openai-compatible-local",
      "base_url": "http://localhost:11434/v1",
      "model": "replace-with-installed-model",
      "secret_env": null,
      "connect_timeout_s": 5,
      "read_timeout_s": 30,
      "total_timeout_s": 120,
      "max_retries": 1,
      "capabilities": {"streaming": true, "tool_calling": false}
    }
  ]
}
